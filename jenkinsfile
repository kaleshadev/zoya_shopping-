pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        DOCKER_IMAGE = 'YOUR_DOCKERHUB_USERNAME/zoya'
        GITHUB_REPO_URL = 'https://github.com/YOUR_GITHUB_USERNAME/zoya-ecommerce-devops.git'
        DOCKER_CREDENTIALS = 'dockerhub-creds'
        GIT_CREDENTIALS = 'github-creds'
        SONAR_SERVER = 'sonarqube-server'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: "${GIT_CREDENTIALS}",
                    url: "${GITHUB_REPO_URL}"
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Application') {
            steps {
                sh 'npm run build'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONAR_SERVER}") {
                    sh '''
                        sonar-scanner \
                        -Dsonar.projectKey=zoya-ecommerce \
                        -Dsonar.sources=src \
                        -Dsonar.exclusions=**/node_modules/**
                    '''
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan . --format HTML --format XML',
                    odcInstallation: 'DP-Check'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    trivy fs \
                    --exit-code 0 \
                    --severity HIGH,CRITICAL .
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                    -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                    --exit-code 0 \
                    --severity HIGH,CRITICAL \
                    ${DOCKER_IMAGE}:${BUILD_NUMBER}
                """
            }
        }

        stage('Docker Hub Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" --password-stdin
                    '''

                    sh """
                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                    """

                    sh 'docker logout'
                }
            }
        }

        stage('Update Kubernetes Image') {
            steps {
                sh """
                    sed -i \
                    's|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|' \
                    Kubernetes/deployment.yml
                """

                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git add Kubernetes/deployment.yml

                    git commit -m "Update ZOYA image tag [skip ci]" || true
                '''

                withCredentials([
                    usernamePassword(
                        credentialsId: "${GIT_CREDENTIALS}",
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        git push \
                        "https://${GIT_USER}:${GIT_TOKEN}@${GITHUB_REPO_URL#https://}" \
                        HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'ZOYA CI pipeline completed successfully.'
            echo 'Docker image pushed and Kubernetes manifest updated.'
        }

        failure {
            echo 'ZOYA pipeline failed. Check Jenkins console output.'
        }
    }
}
